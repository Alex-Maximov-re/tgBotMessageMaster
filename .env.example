# Ключи своего аккаунта: Авито → Для профессионалов → API
# https://www.avito.ru/professionals/api
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=

# Необязательно. Если пусто, бот возьмёт id из GET /core/v1/accounts/self
AVITO_USER_ID=

# Токен от @BotFather и id чата, куда слать уведомления.
# Напишите боту любое сообщение и посмотрите chat.id через python -m app check
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Секрет в адресе вебхука, чтобы чужой POST не превратился в уведомление.
# Только латиница и цифры, например результат: python -c "import secrets; print(secrets.token_hex(16))"
WEBHOOK_SECRET=

# Публичный HTTPS без пути, например https://xxxx.trycloudflare.com
# Пусто — бот поднимется, но сам вебхук в Авито не зарегистрирует.
PUBLIC_BASE_URL=

# Регистрировать вебхук при запуске, если PUBLIC_BASE_URL задан.
SUBSCRIBE_ON_START=true

HOST=127.0.0.1
PORT=8080

# Запасной опрос непрочитанных чатов, секунды. 0 — выключен.
# Имеет смысл, пока нет публичного HTTPS. Первые уже лежащие непрочитанные не шлёт.
POLL_INTERVAL_SECONDS=0

# Прислать и те непрочитанные, которые уже были на первом опросе.
POLL_NOTIFY_EXISTING=false

# Слать уведомления и о своих исходящих сообщениях.
NOTIFY_OWN_MESSAGES=false

STATE_PATH=data/state.json

# Опрос почты, если API Авито недоступен.
# В Авито включите письма о новых сообщениях на этот же ящик.
# IMAP_HOST можно не указывать для yandex, mail.ru, gmail и outlook: он выберется по адресу.
# Пароль — пароль приложения, его включают в настройках почты вместе с IMAP.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Как часто проверять ящик, секунды. Минимум 15.
MAIL_POLL_SECONDS=60

# За сколько дней смотреть письма на первом запуске.
MAIL_LOOKBACK_DAYS=3

# Прислать и те письма о сообщениях, которые уже лежали в ящике.
MAIL_NOTIFY_EXISTING=false

# Пересылать любое письмо с домена Авито, а не только похожее на переписку.
MAIL_ACCEPT_ALL=false
